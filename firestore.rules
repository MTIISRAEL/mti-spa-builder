rules_version = '2';

// כללי האבטחה של המערכת. התפקיד נקרא ממסמך users/<uid>, שרק מנהל יכול לשנות.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return signedIn() && role() in roles;
    }

    // כל משתמש קורא את המסמך של עצמו כדי לדעת את תפקידו. רק מנהל יוצר ומשנה משתמשים.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasRole(['admin']));
      allow write: if hasRole(['admin']);
    }

    // הזמנות: כל משתמש מורשה רואה אותן. כתיבה רק למי שמנהל את ההזמנה, מחיקה רק למנהל.
    match /orders/{orderId} {
      allow read: if hasRole(['admin', 'sales', 'planner', 'warehouse', 'factory', 'accounting']);
      allow create, update: if hasRole(['admin', 'sales', 'planner']);
      allow delete: if hasRole(['admin']);
    }

    // תבניות יצרן: כולם קוראים כדי לטעון פריסה, רק מנהל ומתכנן משנים.
    match /presets/{presetId} {
      allow read: if hasRole(['admin', 'sales', 'planner', 'warehouse', 'factory', 'accounting']);
      allow write: if hasRole(['admin', 'planner']);
    }

    // כל שאר המסמכים חסומים.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
